# Copy to .env. `npm start` and compose.yaml both read it.

# Ollama: a pulled model with the "tools" capability (`ollama show <model>`).
# In Docker, compose points five at Ollama on the host (host.docker.internal).
# FIVE_OLLAMA_MODEL=qwen3.5:9b
# FIVE_OLLAMA_ENDPOINT=http://localhost:11434
# The window Ollama loads the model with; memory grows with it.
# FIVE_CONTEXT_TOKENS=32768
# FIVE_OLLAMA_KEEP_ALIVE=30m
# Whether a thinking model (qwen3.5) thinks before each reply: on or off.
# FIVE_THINK=off

# The directory five works in. All of its data lives there, under .five/.
# FIVE_WORKSPACE=.

# Model calls one turn may take; the pause between turns.
# FIVE_MAX_STEPS=30
# FIVE_TURN_DELAY_MS=1000
# Start looping at startup even if the loop was paused when five last stopped
# (a loop that was running always resumes).
# FIVE_AUTOSTART=off
# Above this share of the window (percent) used by the last call, five starts
# the turn's prompt with a warning to free the context; 0 turns it off.
# FIVE_CONTEXT_WARN=60
# After this many turns in a row without a tool call, five pauses the loop; 0
# never does.
# FIVE_IDLE_TURNS=3
# Limits of one code run.
# FIVE_RUN_TIMEOUT_MS=60000
# FIVE_RUN_MEMORY_MB=1024

# Where the HTTP API and web UI listen. There is no sign-in: on 0.0.0.0, anyone
# on the network can drive five, and five runs any code.
# FIVE_API_ADDR=127.0.0.1:5555
# Docker: the host interface compose publishes port 5555 on (default every one).
# FIVE_PUBLISH=0.0.0.0

# debug | info | warn | error. The file is relative to the workspace; "off" writes none.
# FIVE_LOG_LEVEL=info
# FIVE_LOG_FILE=.five/five.log
